# Copy to .env.local (git-ignored) or export in your shell. Never commit real values.
# Only the offline pipelines read these; the deployed API needs no secrets.

# TMDB v3 API key, for pipelines/ingest_tmdb.py and pipelines/repair_tv_metadata.py.
# See docs/AUDIT.md for TMDB's terms before using it.
TMDB_API_KEY=

# Local frontend development: where `npm run dev` proxies /api (defaults to the deployed API).
API_PROXY=http://localhost:8000
